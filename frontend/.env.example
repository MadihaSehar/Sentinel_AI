# Base URL of the FastAPI backend (section 33's REST API).
# ws(s):// equivalent is derived automatically for the live events socket.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Dashboard operator sign-in. The dashboard bootstraps a single backend
# user (register-or-login) and stores the bearer token in the browser.
# Override these for a non-default operator account. The domain must be a
# real-looking one (the backend rejects reserved TLDs like .local / .test).
NEXT_PUBLIC_DASHBOARD_EMAIL=dashboard@sentinelai.example.com
NEXT_PUBLIC_DASHBOARD_PASSWORD=sentinel-dashboard-dev
