# --- App ---
APP_NAME=SentinelAI
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- AI Providers (Phase 9) ---
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Scan governance ---
MAX_SCAN_RATE_LIMIT=20
MAX_SCAN_CONCURRENCY=25
DEFAULT_SCAN_RATE_LIMIT=5
DEFAULT_SCAN_CONCURRENCY=10

# --- Tool paths (Phase 3+, left here so the file stays authoritative) ---
NUCLEI_PATH=
SUBFINDER_PATH=
DNSX_PATH=
HTTPX_PATH=
KATANA_PATH=
FFUF_PATH=
